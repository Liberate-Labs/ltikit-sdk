{
  "name": "ltikit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime-, storage-, and framework-agnostic LTI 1.3 (LTI Advantage) toolkit.",
  "license": "MIT",
  "author": "Liberate Labs <hasanmahmud@liberate-labs.com>",
  "homepage": "https://liberate-labs.github.io/ltikit-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liberate-Labs/ltikit-sdk.git"
  },
  "bugs": "https://github.com/Liberate-Labs/ltikit-sdk/issues",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "typecheck": "pnpm --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=18"
  }
}
