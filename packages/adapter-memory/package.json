{
  "name": "@ltikit/adapter-memory",
  "version": "1.0.0-rc.4",
  "description": "In-memory NonceStore/PlatformStore adapters for ltikit — dev + testing.",
  "license": "MIT",
  "author": "Liberate Labs <hasanmahmud@liberate-labs.com>",
  "homepage": "https://liberate-labs.github.io/ltikit-sdk/guides/storage/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liberate-Labs/ltikit-sdk.git",
    "directory": "packages/adapter-memory"
  },
  "bugs": "https://github.com/Liberate-Labs/ltikit-sdk/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ltikit/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
